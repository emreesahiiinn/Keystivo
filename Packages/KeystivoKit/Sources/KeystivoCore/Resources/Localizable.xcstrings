    "onboarding.welcomeBody" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Launcher, Fensterwechsel, Tastaturnavigation, Audiomixer, Gesten und Automation – in einer schnellen, nativen App."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Launcher, window switching, keyboard navigation, audio mixer, gestures and automation — in one fast, native app."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lanzador, cambio de ventanas, navegación con teclado, mezclador de audio, gestos y automatización, en una sola app nativa y rápida."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lanceur, changement de fenêtre, navigation au clavier, mixeur audio, gestes et automatisation — dans une seule app native et rapide."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Launcher, cambio finestre, navigazione da tastiera, mixer audio, gesti e automazione in un'unica app veloce e nativa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ランチャー、ウインドウ切り替え、キーボードナビゲーション、オーディオミキサー、ジェスチャ、オートメーションを、高速でネイティブなひとつのアプリに。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "런처, 윈도우 전환, 키보드 내비게이션, 오디오 믹서, 제스처, 자동화를 하나의 빠른 네이티브 앱에서."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iniciador, alternância de janelas, navegação por teclado, mixer de áudio, gestos e automação — em um app rápido e nativo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Лаунчер, переключение окон, навигация с клавиатуры, аудиомикшер, жесты и автоматизация — в одном быстром нативном приложении."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Başlatıcı, pencere geçişi, klavyeyle gezinme, ses mikseri, hareketler ve otomasyon — tek bir hızlı, yerel uygulamada."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "启动器、窗口切换、键盘导航、音频混音器、手势与自动化——集于一款快速的原生 App。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "啟動器、視窗切換、鍵盤導覽、音訊混音器、手勢與自動化——集於一款快速的原生 App。"
          }
        }
      }
    },
