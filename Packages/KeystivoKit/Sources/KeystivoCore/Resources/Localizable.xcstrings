    "record.footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einen Bereich auswählen oder klicken, um ein ganzes Display aufzunehmen. Zum Beenden die Aktion erneut ausführen oder auf „Stoppen“ klicken. Aufnahmen werden als QuickTime-Filme gesichert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose an area or click to record a whole display. Run the action again or click Stop to finish. Recordings are saved as QuickTime movies."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige un área o haz clic para grabar una pantalla completa. Vuelve a ejecutar la acción o haz clic en Detener para terminar. Las grabaciones se guardan como películas de QuickTime."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez une zone ou cliquez pour enregistrer un écran entier. Exécutez à nouveau l'action ou cliquez sur Arrêter pour terminer. Les enregistrements sont sauvegardés sous forme de vidéos QuickTime."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli un'area o fai clic per registrare un intero monitor. Esegui di nuovo l'azione o fai clic su Interrompi per terminare. Le registrazioni vengono salvate come filmati QuickTime."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "領域を選択するか、クリックしてディスプレイ全体を収録します。終了するには、アクションをもう一度実行するか「停止」をクリックします。収録はQuickTimeムービーとして保存されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "영역을 선택하거나 클릭하여 디스플레이 전체를 기록합니다. 끝내려면 동작을 다시 실행하거나 ‘중단’을 클릭하십시오. 기록은 QuickTime 동영상으로 저장됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha uma área ou clique para gravar uma tela inteira. Execute a ação novamente ou clique em Parar para terminar. As gravações são salvas como filmes do QuickTime."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выделите область или нажмите на дисплей, чтобы записать его целиком. Чтобы завершить, выполните действие еще раз или нажмите «Остановить». Записи сохраняются как видео QuickTime."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir alan seçin veya tüm ekranı kaydetmek için tıklayın. Bitirmek için eylemi yeniden çalıştırın veya Durdur'u tıklayın. Kayıtlar QuickTime filmi olarak kaydedilir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择一个区域，或点按以录制整个显示器。再次运行该操作或点按“停止”即可结束。录制内容将存储为 QuickTime 影片。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選擇一個區域，或按一下以錄製整個顯示器。再次執行此動作或按一下「停止」即可結束。錄製內容會儲存為 QuickTime 影片。"
          }
        }
      }
    },
