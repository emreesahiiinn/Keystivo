    "profiles.selectBody" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profile bündeln Kurzbefehle, Audio, Energie und Fensterlayouts für verschiedene Situationen wie Arbeit und Privates."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profiles bundle shortcuts, audio, power and window layouts for different situations such as work and personal use."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los perfiles agrupan funciones rápidas, audio, energía y disposiciones de ventanas para distintas situaciones, como el trabajo y el uso personal."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les profils regroupent raccourcis, audio, énergie et dispositions de fenêtres pour différentes situations, comme le travail et l'usage personnel."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I profili raggruppano abbreviazioni, audio, energia e disposizioni delle finestre per situazioni diverse, come il lavoro e l'uso personale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プロファイルは、仕事用や個人用など、状況に応じたショートカット、オーディオ、電源、ウインドウレイアウトをひとまとめにしたものです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "프로필은 업무용, 개인용 등 다양한 상황에 맞게 단축키, 오디오, 전원 및 윈도우 레이아웃을 하나로 묶습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os perfis reúnem atalhos, áudio, energia e layouts de janelas para diferentes situações, como trabalho e uso pessoal."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Профили объединяют сочетания клавиш, звук, питание и макеты окон для разных ситуаций, например для работы и личного использования."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profiller; kısayolları, ses, güç ve pencere yerleşimlerini iş ve kişisel kullanım gibi farklı durumlar için bir araya getirir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "情景模式将快捷键、音频、电源和窗口布局组合在一起，适用于工作、个人使用等不同场景。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設定檔可將快速鍵、音訊、電源和視窗佈局組合在一起，適用於工作和個人使用等不同情境。"
          }
        }
      }
    },
