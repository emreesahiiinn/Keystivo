        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Histórico pesquisável de tudo o que você copia — textos, links, imagens, arquivos e cores."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "История всего, что вы копируете, с поиском — текст, ссылки, изображения, файлы и цвета."
