    "plugins.error.badID" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Plug-in-ID darf nur Buchstaben, Ziffern, Punkte, Bindestriche und Unterstriche enthalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The plugin ID may only contain letters, digits, dots, dashes and underscores."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El ID del plugin solo puede contener letras, números, puntos, guiones y guiones bajos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'identifiant du plug-in ne peut contenir que des lettres, des chiffres, des points, des tirets et des traits de soulignement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'ID del plugin può contenere solo lettere, cifre, punti, trattini e trattini bassi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プラグインIDに使用できるのは、英字、数字、ピリオド、ハイフン、アンダースコアのみです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "플러그인 ID에는 문자, 숫자, 마침표, 대시, 밑줄만 사용할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O ID do plug-in só pode conter letras, dígitos, pontos, hifens e sublinhados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ID плагина может содержать только буквы, цифры, точки, дефисы и подчеркивания."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eklenti kimliği yalnızca harf, rakam, nokta, kısa çizgi ve alt çizgi içerebilir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "插件 ID 只能包含字母、数字、点、短横线和下划线。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "外掛程式 ID 只能包含字母、數字、句點、連字號和底線。"
          }
        }
      }
    },
