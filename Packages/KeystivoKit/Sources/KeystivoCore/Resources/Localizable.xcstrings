    "automation.intro" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Workflows reagieren auf Ereignisse – das Öffnen oder Beenden einer App, einen Zeitplan, einen Kurzbefehl, ein angeschlossenes Display oder Gerät –, prüfen optionale Bedingungen und führen eine Reihe von Schritten aus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Workflows react to events — an app opening or quitting, a schedule, a shortcut, a display or device being connected — check optional conditions and run a series of steps."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los flujos de trabajo reaccionan a eventos (una app que se abre o se cierra, una programación, una función rápida, una pantalla o un dispositivo que se conecta), comprueban condiciones opcionales y ejecutan una serie de pasos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les workflows réagissent à des événements — ouverture ou fermeture d'une app, horaire, raccourci, connexion d'un écran ou d'un appareil —, vérifient des conditions facultatives et exécutent une série d'étapes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I flussi di lavoro reagiscono agli eventi (l'apertura o la chiusura di un'app, un orario programmato, un'abbreviazione, il collegamento di un monitor o di un dispositivo), verificano eventuali condizioni ed eseguono una serie di passaggi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ワークフローは、アプリの起動や終了、スケジュール、ショートカット、ディスプレイやデバイスの接続といったイベントに反応し、任意の条件を確認してから一連のステップを実行します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "워크플로는 앱 열기 또는 종료, 일정, 단축키, 디스플레이나 기기 연결 같은 이벤트에 반응하여 선택적 조건을 확인한 후 일련의 단계를 실행합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os fluxos de trabalho reagem a eventos — um app sendo aberto ou encerrado, um horário programado, um atalho, uma tela ou dispositivo sendo conectado —, verificam condições opcionais e executam uma série de etapas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сценарии реагируют на события — открытие или завершение приложения, расписание, сочетание клавиш, подключение дисплея или устройства, — проверяют дополнительные условия и выполняют последовательность шагов."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İş akışları olaylara tepki verir — bir uygulamanın açılması veya kapanması, bir zamanlama, bir kısayol, bir ekranın veya aygıtın bağlanması — isteğe bağlı koşulları denetler ve bir dizi adımı çalıştırır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "工作流程会响应各种事件——App 打开或退出、定时计划、快捷键、显示器或设备接入——检查可选条件，然后运行一系列步骤。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "工作流程會對事件做出反應——App 打開或結束、排程、快速鍵、連接顯示器或裝置——檢查選用的條件，然後執行一系列步驟。"
          }
        }
      }
    },
