    "general.reset.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kurzbefehle, Profile, Workflows und Einstellungen werden auf die Standardwerte zurückgesetzt. Zuvor wird ein Backup gesichert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shortcuts, profiles, workflows and preferences return to their defaults. A backup is saved first."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las funciones rápidas, los perfiles, los flujos de trabajo y las preferencias vuelven a sus valores predeterminados. Antes se guarda una copia de seguridad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les raccourcis, profils, workflows et préférences reprennent leurs valeurs par défaut. Une sauvegarde est d'abord enregistrée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abbreviazioni, profili, flussi di lavoro e preferenze tornano ai valori predefiniti. Prima viene salvato un backup."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ショートカット、プロファイル、ワークフロー、環境設定がデフォルトに戻ります。事前にバックアップが保存されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "단축키, 프로필, 워크플로 및 환경설정이 기본값으로 돌아갑니다. 먼저 백업이 저장됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atalhos, perfis, fluxos de trabalho e preferências voltam aos padrões. Um backup é salvo antes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сочетания клавиш, профили, сценарии и параметры вернутся к значениям по умолчанию. Перед этим будет сохранена резервная копия."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kısayollar, profiller, iş akışları ve tercihler varsayılan değerlerine döner. Önce bir yedek kaydedilir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "快捷键、情景模式、工作流程和偏好设置将恢复为默认值。重置前会先进行备份。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "快速鍵、設定檔、工作流程和偏好設定將回復為預設值。系統會先儲存備份。"
          }
        }
      }
    },
