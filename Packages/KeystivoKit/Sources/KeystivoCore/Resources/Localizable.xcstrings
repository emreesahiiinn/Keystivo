    "permission.accessibility.reason" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erforderlich, um Fenster zu bewegen und ihre Größe zu ändern, Bildschirmelemente für die Tastaturnavigation zu lesen sowie globale Gesten und Texterweiterung zu nutzen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Required to move and resize windows, read on-screen elements for keyboard navigation, and use global gestures and text expansion."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Necesario para mover y redimensionar ventanas, leer los elementos de la pantalla para la navegación con teclado y usar gestos globales y la expansión de texto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nécessaire pour déplacer et redimensionner les fenêtres, lire les éléments à l'écran pour la navigation au clavier, et utiliser les gestes globaux et l'expansion de texte."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Necessario per spostare e ridimensionare le finestre, leggere gli elementi sullo schermo per la navigazione da tastiera e usare gesti globali ed espansione del testo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ウインドウの移動とサイズ変更、キーボードナビゲーションのための画面上の要素の読み取り、グローバルなジェスチャとテキスト展開の使用に必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "윈도우를 이동하고 크기를 조절하며, 키보드 내비게이션을 위해 화면 요소를 읽고, 전역 제스처 및 텍스트 확장을 사용하는 데 필요합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Necessária para mover e redimensionar janelas, ler elementos na tela para a navegação por teclado e usar gestos globais e expansão de texto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нужно для перемещения и изменения размера окон, чтения элементов на экране для навигации с клавиатуры, а также для глобальных жестов и подстановки текста."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pencereleri taşımak ve yeniden boyutlandırmak, klavyeyle gezinme için ekrandaki öğeleri okumak, genel hareketleri ve metin genişletmeyi kullanmak için gereklidir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用于移动窗口和调整窗口大小、读取屏幕元素以进行键盘导航，以及使用全局手势和文本扩展。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用於移動視窗及調整其大小、讀取螢幕上的元素以進行鍵盤導覽，以及使用全域手勢和文字展開。"
          }
        }
      }
    },
