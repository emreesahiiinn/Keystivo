    "about.tagline" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Launcher, Fenstermanager, Tastaturnavigation, Audiomixer, Gesten und Automation – eine schnelle, native, private Mac-App."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Launcher, window manager, keyboard navigation, audio mixer, gestures and automation — one fast, native, private Mac app."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lanzador, gestor de ventanas, navegación con teclado, mezclador de audio, gestos y automatización: una sola app para Mac rápida, nativa y privada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lanceur, gestionnaire de fenêtres, navigation au clavier, mixeur audio, gestes et automatisation — une seule app Mac rapide, native et respectueuse de votre vie privée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Launcher, gestione finestre, navigazione da tastiera, mixer audio, gesti e automazione: un'unica app per Mac veloce, nativa e riservata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ランチャー、ウインドウ管理、キーボードナビゲーション、オーディオミキサー、ジェスチャ、オートメーションを、高速・ネイティブ・プライベートなひとつのMacアプリに。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "런처, 윈도우 관리자, 키보드 내비게이션, 오디오 믹서, 제스처, 자동화를 하나로 담은 빠르고 개인정보를 보호하는 네이티브 Mac 앱."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iniciador, gerenciador de janelas, navegação por teclado, mixer de áudio, gestos e automação — um app para Mac rápido, nativo e privado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Лаунчер, менеджер окон, навигация с клавиатуры, аудиомикшер, жесты и автоматизация — в одном быстром, нативном и приватном приложении для Mac."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Başlatıcı, pencere yöneticisi, klavyeyle gezinme, ses mikseri, hareketler ve otomasyon — tek bir hızlı, yerel ve gizliliğe saygılı Mac uygulaması."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "启动器、窗口管理、键盘导航、音频混音器、手势与自动化——集于一款快速、原生、注重隐私的 Mac App。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "啟動器、視窗管理、鍵盤導覽、音訊混音器、手勢與自動化——集於一款快速、原生且注重隱私的 Mac App。"
          }
        }
      }
    },
