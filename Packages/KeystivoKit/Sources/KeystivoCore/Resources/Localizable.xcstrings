    "profiles.explanation" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kurzbefehle, Gesten und Workflows lassen sich auf Profile beschränken. Beim Profilwechsel werden außerdem die folgenden Einstellungen angewendet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shortcuts, gestures and workflows can be limited to profiles. Switching profiles also applies the settings below."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las funciones rápidas, los gestos y los flujos de trabajo se pueden limitar a perfiles. Al cambiar de perfil también se aplican los ajustes siguientes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les raccourcis, gestes et workflows peuvent être limités à certains profils. Changer de profil applique également les réglages ci-dessous."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abbreviazioni, gesti e flussi di lavoro possono essere limitati a determinati profili. Il cambio di profilo applica anche le impostazioni qui sotto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ショートカット、ジェスチャ、ワークフローは、特定のプロファイルに限定できます。プロファイルを切り替えると、以下の設定も適用されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "단축키, 제스처 및 워크플로를 특정 프로필로 제한할 수 있습니다. 프로필을 전환하면 아래 설정도 적용됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atalhos, gestos e fluxos de trabalho podem ser limitados a perfis. Alternar de perfil também aplica os ajustes abaixo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сочетания клавиш, жесты и сценарии можно ограничить профилями. При переключении профиля также применяются настройки ниже."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kısayollar, hareketler ve iş akışları belirli profillerle sınırlandırılabilir. Profil değiştirmek aşağıdaki ayarları da uygular."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "快捷键、手势和工作流程可以限定于特定情景模式。切换情景模式时也会应用以下设置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "快速鍵、手勢和工作流程可以限定於特定設定檔。切換設定檔時也會套用以下設定。"
          }
        }
      }
    },
