    "screenTools.displaysFooter" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auflösungen wechseln (inklusive HiDPI-Modi) und jedes Display abdunkeln, auch externe Monitore ohne Helligkeitsregelung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Switch resolutions (including HiDPI modes) and dim any display, including external monitors without brightness controls."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambia de resolución (incluidos los modos HiDPI) y atenúa cualquier pantalla, incluidos los monitores externos sin control de brillo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Changez de résolution (y compris les modes HiDPI) et assombrissez n'importe quel écran, même les moniteurs externes sans réglage de luminosité."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambia risoluzione (incluse le modalità HiDPI) e oscura qualsiasi monitor, compresi quelli esterni senza controlli della luminosità."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "解像度（HiDPIモードを含む）を切り替えたり、明るさ調整機能のない外部モニタを含むあらゆるディスプレイを暗くしたりできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "해상도(HiDPI 모드 포함)를 전환하고, 밝기 조절 기능이 없는 외장 모니터를 포함한 모든 디스플레이를 어둡게 합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alterne resoluções (incluindo modos HiDPI) e escureça qualquer tela, incluindo monitores externos sem controle de brilho."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Переключайте разрешения (включая режимы HiDPI) и затемняйте любой дисплей, в том числе внешние мониторы без регулировки яркости."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çözünürlüğü değiştirin (HiDPI modları dahil) ve parlaklık denetimi olmayan harici monitörler dahil her ekranı karartın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "切换分辨率（包括 HiDPI 模式）并调暗任意显示器，包括没有亮度控制的外接显示器。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "切換解析度（包括 HiDPI 模式），並調暗任何顯示器，包括沒有亮度控制的外接顯示器。"
          }
        }
      }
    },
