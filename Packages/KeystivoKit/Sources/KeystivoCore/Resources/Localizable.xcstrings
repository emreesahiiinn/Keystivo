          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設定をほかのMacに移したり、一部を共有したり、以前のバージョンに戻したりできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "설정을 다른 Mac으로 옮기거나, 일부를 공유하거나, 이전 버전으로 되돌리십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
