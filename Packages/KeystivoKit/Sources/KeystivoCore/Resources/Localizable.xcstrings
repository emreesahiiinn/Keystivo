    "library.evening.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An Werktagen abends Arbeits-Chat und E-Mail beenden und an den Feierabend erinnern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On weekday evenings, quit work chat and email and remind you to wrap up."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las tardes de los días laborables, cierra el chat y el correo del trabajo y te recuerda que es hora de terminar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les soirs de semaine, quitte la messagerie professionnelle et le courrier, et vous rappelle de terminer votre journée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nelle sere dei giorni feriali chiude la chat di lavoro e l'email e ti ricorda di concludere la giornata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "平日の夕方に、仕事用のチャットとメールを終了し、作業を切り上げるよう通知します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "평일 저녁에 업무용 채팅과 이메일을 종료하고 하루를 마무리하도록 알려줍니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nas noites de dias úteis, encerrar os apps de chat e e-mail do trabalho e lembrar você de finalizar o dia."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "По будням вечером завершать рабочие мессенджеры и почту и напоминать о завершении дня."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hafta içi akşamları iş sohbeti ve e-posta uygulamalarından çıkar ve size günü toparlamanızı hatırlatır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在工作日晚上退出工作聊天和邮件 App，并提醒你收尾。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "平日傍晚結束工作用的聊天和郵件 App，並提醒你收尾。"
          }
        }
      }
    },
