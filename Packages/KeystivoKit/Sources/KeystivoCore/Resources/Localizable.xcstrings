    "mouseKeyboard.subtitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Getrenntes Scrollen für Maus und Trackpad, weiches Scrollen, Seitentasten, Hyper-Taste und Tastenbelegung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Separate mouse and trackpad scrolling, smooth scrolling, side buttons, Hyper key and key remapping."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desplazamiento independiente para ratón y trackpad, desplazamiento suave, botones laterales, tecla Hyper y reasignación de teclas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Défilement distinct pour la souris et le trackpad, défilement fluide, boutons latéraux, touche Hyper et remappage des touches."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scorrimento separato per mouse e trackpad, scorrimento fluido, pulsanti laterali, tasto Hyper e rimappatura dei tasti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マウスとトラックパッドのスクロールの分離、スムーズスクロール、サイドボタン、Hyperキー、キーのリマップ。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "마우스와 트랙패드 스크롤 분리, 부드러운 스크롤, 측면 버튼, Hyper 키 및 키 리매핑."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rolagem separada para mouse e trackpad, rolagem suave, botões laterais, tecla Hyper e remapeamento de teclas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Раздельная прокрутка мыши и трекпада, плавная прокрутка, боковые кнопки, клавиша Hyper и переназначение клавиш."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayrı fare ve izleme dörtgeni kaydırması, yumuşak kaydırma, yan düğmeler, Hyper tuşu ve tuş yeniden eşleme."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "分别设置鼠标和触控板滚动、平滑滚动、侧键、Hyper 键以及按键重映射。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "分開設定滑鼠與觸控式軌跡板捲動、平滑捲動、側邊按鈕、Hyper 鍵及按鍵重新對應。"
          }
        }
      }
    },
