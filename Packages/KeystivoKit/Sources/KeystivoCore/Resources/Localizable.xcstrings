    "workspaces.focusFooter" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tipp: Einen macOS-Kurzbefehl erstellen, der einen Fokus (z. B. „Nicht stören“) aktiviert, und dessen Namen eingeben, um ihn automatisch einzuschalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tip: create a macOS Shortcut that turns on a Focus (e.g. Do Not Disturb) and enter its name to switch it on automatically."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consejo: crea un atajo en la app Atajos que active un modo de concentración (p. ej., No molestar) e introduce su nombre para activarlo automáticamente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Astuce : créez dans Raccourcis un raccourci qui active un mode de concentration (p. ex. Ne pas déranger) et saisissez son nom pour l'activer automatiquement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suggerimento: crea un comando rapido di macOS che attivi una modalità Full immersion (ad es. Non disturbare) e inseriscine il nome per attivarla automaticamente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ヒント：集中モード（おやすみモードなど）をオンにするmacOSのショートカットを作成し、その名前を入力すると、自動的にオンにできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "팁: 집중 모드(예: 방해 금지 모드)를 켜는 macOS 단축어를 만들고 그 이름을 입력하면 자동으로 켜집니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dica: crie um atalho no app Atalhos do macOS que ative um Foco (por ex., Não Perturbe) e digite o nome dele para ativá-lo automaticamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Совет: создайте в macOS быструю команду, которая включает режим фокусирования (например, «Не беспокоить»), и введите ее название, чтобы включать его автоматически."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İpucu: Kestirmeler uygulamasında bir Odak'ı (ör. Rahatsız Etme) açan bir kestirme oluşturun ve otomatik olarak açılması için adını buraya girin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "提示：创建一个用于打开某个专注模式（例如勿扰模式）的 macOS 快捷指令，并在此输入其名称，即可自动打开该专注模式。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "提示：建立一個可開啟專注模式（例如「勿擾模式」）的 macOS 捷徑，並輸入其名稱，即可自動開啟。"
          }
        }
      }
    },
