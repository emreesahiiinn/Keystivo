    "automation.subtitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auslöser → Bedingung → Aktionen. Mehrstufige Workflows erstellen, mit der Bibliothek beginnen und als Dateien teilen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trigger → condition → actions. Build multi-step workflows, start from the library and share them as files."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activador → condición → acciones. Crea flujos de trabajo de varios pasos, parte de la biblioteca y compártelos como archivos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déclencheur → condition → actions. Créez des workflows en plusieurs étapes, partez de la bibliothèque et partagez-les sous forme de fichiers."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attivatore → condizione → azioni. Crea flussi di lavoro in più passaggi, parti dalla libreria e condividili come file."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "トリガー → 条件 → アクション。複数ステップのワークフローを作成したり、ライブラリから始めたり、ファイルとして共有したりできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "트리거 → 조건 → 동작. 여러 단계로 된 워크플로를 만들거나 라이브러리에서 시작하고, 파일로 공유하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gatilho → condição → ações. Crie fluxos de trabalho com várias etapas, comece pela biblioteca e compartilhe-os como arquivos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Триггер → условие → действия. Создавайте многошаговые сценарии, начинайте с библиотеки и делитесь ими в виде файлов."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tetikleyici → koşul → eylemler. Çok adımlı iş akışları oluşturun, kitaplıktan başlayın ve bunları dosya olarak paylaşın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "触发器 → 条件 → 操作。构建多步骤工作流程，从资源库起步，并以文件形式共享。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "觸發器 → 條件 → 動作。建立多步驟工作流程、從範本庫開始，並以檔案分享。"
          }
        }
      }
    },
    "automation.triggers" : {
