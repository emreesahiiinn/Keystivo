        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consejo: abre el lanzador y escribe lo que quieres hacer; todos los comandos de Keystivo se pueden buscar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
