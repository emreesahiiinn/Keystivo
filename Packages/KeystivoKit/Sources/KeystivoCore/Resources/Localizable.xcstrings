    "audioSettings.perAppFooter" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keystivo verarbeitet den Ton einer App nur, wenn ihre Lautstärke geändert oder sie stummgeschaltet wird. Apps mit 100 % bleiben unangetastet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keystivo only processes an app's audio when you change its volume or mute it. Apps at 100% are never touched."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keystivo solo procesa el audio de una app cuando cambias su volumen o la silencias. Las apps al 100 % nunca se tocan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keystivo ne traite l'audio d'une app que lorsque vous modifiez son volume ou coupez son son. Les apps à 100 % ne sont jamais modifiées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keystivo elabora l'audio di un'app solo quando ne modifichi il volume o lo disattivi. Le app al 100% non vengono mai toccate."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keystivoは、音量を変更したり消音したりしたアプリのオーディオだけを処理します。100%のアプリには一切手を加えません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keystivo는 앱의 음량을 변경하거나 음소거할 때만 해당 앱의 오디오를 처리합니다. 음량이 100%인 앱은 전혀 건드리지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Keystivo só processa o áudio de um app quando você altera o volume dele ou o silencia. Apps em 100% nunca são alterados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keystivo обрабатывает звук приложения, только когда вы меняете его громкость или выключаете звук. Приложения с громкостью 100 % не затрагиваются."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keystivo bir uygulamanın sesini yalnızca ses düzeyini değiştirdiğinizde veya sesini kapattığınızda işler. %100 düzeyindeki uygulamalara asla dokunulmaz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只有当你更改某个 App 的音量或将其静音时，Keystivo 才会处理其音频。音量为 100% 的 App 完全不受影响。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keystivo 只會在你更改 App 的音量或將其靜音時處理其音訊。音量為 100% 的 App 完全不受影響。"
          }
        }
      }
    },
