        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これらのショートカットはどこでも使えます。すべて「設定」›「ショートカット」で変更できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 단축키는 어디서나 작동합니다. 설정 › 단축키에서 모두 변경할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estes atalhos funcionam em qualquer lugar. Você pode alterar todos eles em Ajustes › Atalhos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эти сочетания клавиш работают везде. Все их можно изменить в разделе «Настройки» › «Сочетания клавиш»."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu kısayollar her yerde çalışır. Tümünü Ayarlar › Kısayollar bölümünden değiştirebilirsiniz."
