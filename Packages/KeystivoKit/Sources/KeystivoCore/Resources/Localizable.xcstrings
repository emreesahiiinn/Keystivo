    "onboarding.shortcutsBody" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Kurzbefehle funktionieren überall. Alle lassen sich unter Einstellungen › Kurzbefehle ändern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "These shortcuts work everywhere. You can change all of them in Settings › Shortcuts."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estas funciones rápidas funcionan en cualquier lugar. Puedes cambiarlas todas en Ajustes › Funciones rápidas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ces raccourcis fonctionnent partout. Vous pouvez tous les modifier dans Réglages › Raccourcis."
          }
        },
        "it" : {
          "stringUnit" : {
