    "files.rulesFooter" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keystivo überwacht jeden Ordner und wendet eine Regel an, wenn eine Datei passt – Downloads aufräumen, Bildschirmfotos archivieren, alte Installationsprogramme löschen. Nur die oberste Ebene des Ordners wird geprüft."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keystivo watches each folder and applies a rule when a file matches — tidy Downloads, archive screenshots, delete old installers. Only the folder's top level is checked."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keystivo vigila cada carpeta y aplica una regla cuando un archivo coincide: ordena Descargas, archiva capturas de pantalla, elimina instaladores antiguos. Solo se comprueba el nivel superior de la carpeta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keystivo surveille chaque dossier et applique une règle lorsqu'un fichier correspond — rangez Téléchargements, archivez les captures d'écran, supprimez les anciens programmes d'installation. Seul le premier niveau du dossier est vérifié."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keystivo controlla ogni cartella e applica una regola quando un file corrisponde: riordina Download, archivia le istantanee, elimina i vecchi programmi di installazione. Viene controllato solo il livello principale della cartella."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keystivoは各フォルダを監視し、ファイルが一致したときにルールを適用します。ダウンロードの整理、スクリーンショットのアーカイブ、古いインストーラの削除などに使えます。確認されるのはフォルダの最上位の階層のみです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keystivo는 각 폴더를 감시하다가 파일이 일치하면 규칙을 적용합니다. 다운로드 폴더 정리, 스크린샷 보관, 오래된 설치 프로그램 삭제 등에 활용하십시오. 폴더의 최상위 수준만 확인합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Keystivo monitora cada pasta e aplica uma regra quando um arquivo corresponde — organize Downloads, arquive capturas de tela, apague instaladores antigos. Apenas o nível superior da pasta é verificado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keystivo следит за каждой папкой и применяет правило, когда файл ему соответствует: наводит порядок в Загрузках, архивирует снимки экрана, удаляет старые установщики. Проверяется только верхний уровень папки."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keystivo her klasörü izler ve bir dosya eşleştiğinde kuralı uygular — İndirilenler'i toparlayın, ekran resimlerini arşivleyin, eski yükleyicileri silin. Yalnızca klasörün en üst düzeyi denetlenir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keystivo 会监视每个文件夹，并在文件匹配时应用规则——整理“下载”、归档截屏、删除旧安装器。仅检查文件夹的顶层。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keystivo 會監看每個檔案夾，並在檔案符合時套用規則——整理「下載項目」、封存截圖、刪除舊的安裝程式。只會檢查檔案夾的最上層。"
          }
        }
      }
    },
