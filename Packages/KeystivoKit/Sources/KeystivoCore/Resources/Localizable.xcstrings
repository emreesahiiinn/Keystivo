    "switcherSettings.replaceCmdTabFooter" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⌘⇥ öffnet den Fensterumschalter von Keystivo mit Live-Vorschauen. Der macOS-eigene Umschalter kehrt automatisch zurück, wenn der Zugriff widerrufen wird."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⌘⇥ opens Keystivo's window switcher with live previews. macOS's own switcher returns automatically if access is revoked."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⌘⇥ abre el selector de ventanas de Keystivo con vistas previas en tiempo real. El selector propio de macOS vuelve automáticamente si se revoca el acceso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⌘⇥ ouvre le sélecteur de fenêtres de Keystivo avec des aperçus en direct. Le sélecteur de macOS revient automatiquement si l'accès est révoqué."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⌘⇥ apre il selettore finestre di Keystivo con anteprime dal vivo. Il selettore di macOS torna automaticamente se l'accesso viene revocato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⌘⇥で、ライブプレビュー付きのKeystivoのウインドウスイッチャーが開きます。アクセスが取り消されると、macOS標準のスイッチャーに自動的に戻ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⌘⇥를 누르면 실시간 미리보기가 있는 Keystivo 윈도우 전환기가 열립니다. 접근 권한이 취소되면 macOS 기본 전환기가 자동으로 복원됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⌘⇥ abre o alternador de janelas do Keystivo com pré-visualizações ao vivo. O alternador do próprio macOS volta automaticamente se o acesso for revogado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⌘⇥ открывает переключатель окон Keystivo с живыми миниатюрами. Если доступ будет отозван, стандартный переключатель macOS вернется автоматически."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⌘⇥, Keystivo'nun canlı önizlemeli pencere değiştiricisini açar. Erişim geri alınırsa macOS'in kendi değiştiricisi otomatik olarak geri gelir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⌘⇥ 会打开 Keystivo 带实时预览的窗口切换器。如果访问权限被撤销，macOS 自带的切换器会自动恢复。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⌘⇥ 會打開 Keystivo 具即時預覽的視窗切換器。若撤銷取用權限，macOS 原生的切換器會自動恢復。"
          }
        }
      }
    },
