    "library.coding.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xcode und Terminal öffnen, nebeneinander anordnen und eine 50-minütige Fokussitzung starten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
