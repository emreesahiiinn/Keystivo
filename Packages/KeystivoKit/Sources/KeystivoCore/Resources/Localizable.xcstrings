    "backup.subtitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konfiguration zwischen Macs übertragen, Teile davon teilen oder zu einer früheren Version zurückkehren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Move your setup between Macs, share parts of it, or roll back to an earlier version."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Traslada tu configuración entre Macs, comparte partes de ella o vuelve a una versión anterior."
