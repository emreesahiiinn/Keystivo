    "gesturesSettings.trackpadFooter" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Streichen mit zwei Fingern erfordert eine Sondertaste, damit normales Scrollen weiter funktioniert. Gesten, die auch macOS verwendet, sind unten markiert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Two-finger swipes require a modifier key so normal scrolling keeps working. Gestures also used by macOS are flagged below."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los deslizamientos con dos dedos requieren una tecla modificadora para que el desplazamiento normal siga funcionando. Abajo se marcan los gestos que también usa macOS."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les balayages à deux doigts nécessitent une touche de modification afin que le défilement normal continue de fonctionner. Les gestes également utilisés par macOS sont signalés ci-dessous."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli scorrimenti con due dita richiedono un tasto modificatore, così lo scorrimento normale continua a funzionare. I gesti usati anche da macOS sono segnalati qui sotto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通常のスクロールが使えるように、2本指スワイプには修飾キーが必要です。macOSでも使われているジェスチャには、下に印が付きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "일반 스크롤이 계속 작동하도록 두 손가락 쓸어넘기기에는 보조 키가 필요합니다. macOS에서도 사용하는 제스처는 아래에 표시됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gestos de passar com dois dedos exigem uma tecla modificadora para que a rolagem normal continue funcionando. Gestos também usados pelo macOS são sinalizados abaixo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для смахивания двумя пальцами нужна клавиша-модификатор, чтобы обычная прокрутка продолжала работать. Жесты, которые также использует macOS, отмечены ниже."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Normal kaydırmanın çalışmaya devam etmesi için iki parmakla kaydırma hareketleri bir değiştirici tuş gerektirir. macOS tarafından da kullanılan hareketler aşağıda işaretlenir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "双指轻扫需配合修饰键使用，以免影响正常滚动。与 macOS 共用的手势会在下方标出。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "雙指滑動需要搭配變更鍵，以免影響一般捲動。macOS 也使用的手勢會在下方標示。"
          }
        }
      }
    },
