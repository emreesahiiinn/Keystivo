    "permission.audioCapture.reason" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Benötigt für Lautstärke und Stummschaltung pro App. Audio wird in Echtzeit verarbeitet und nie aufgezeichnet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Needed for per-app volume and mute. Audio is processed in real time and never recorded."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Necesario para el volumen y el silencio por app. El audio se procesa en tiempo real y nunca se graba."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nécessaire pour le volume et la sourdine par app. L'audio est traité en temps réel et n'est jamais enregistré."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Necessario per il volume e il muto per app. L'audio viene elaborato in tempo reale e mai registrato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリごとの音量と消音に必要です。オーディオはリアルタイムで処理され、録音されることはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱별 음량 및 음소거에 필요합니다. 오디오는 실시간으로 처리되며 절대 녹음되지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Necessária para volume e silêncio por app. O áudio é processado em tempo real e nunca é gravado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нужно для управления громкостью и выключения звука отдельных приложений. Звук обрабатывается в реальном времени и никогда не записывается."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uygulama başına ses düzeyi ve sessize alma için gerekir. Ses gerçek zamanlı olarak işlenir ve asla kaydedilmez."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用于分 App 音量和静音。音频会被实时处理，绝不会被录制。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用於個別 App 音量與靜音。音訊會即時處理，絕不會被錄製。"
          }
        }
      }
    },
