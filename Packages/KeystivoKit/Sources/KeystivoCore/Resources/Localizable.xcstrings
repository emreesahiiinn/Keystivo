    "clipboardSettings.subtitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durchsuchbarer Verlauf von allem, was kopiert wird – Text, Links, Bilder, Dateien und Farben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Searchable history of everything you copy — text, links, images, files and colors."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Historial con búsqueda de todo lo que copias: texto, enlaces, imágenes, archivos y colores."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Historique consultable de tout ce que vous copiez — texte, liens, images, fichiers et couleurs."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cronologia ricercabile di tutto ciò che copi: testo, link, immagini, file e colori."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コピーしたすべてのもの（テキスト、リンク、イメージ、ファイル、カラー）を検索できる履歴。"
