    "pluginsSettings.trustWarning" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plug-ins führen Skripte mit den Rechten des Benutzers aus. Nur selbst geschriebenen oder geprüften Plug-ins vertrauen. Änderungen an den Dateien eines Plug-ins entziehen das Vertrauen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plugins run scripts with your permissions. Only trust plugins you wrote or reviewed. Changing a plugin's files revokes trust."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los plugins ejecutan scripts con tus permisos. Confía solo en plugins que hayas escrito o revisado. Si cambian los archivos de un plugin, se revoca la confianza."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les plug-ins exécutent des scripts avec vos autorisations. Ne faites confiance qu'aux plug-ins que vous avez écrits ou vérifiés. Toute modification des fichiers d'un plug-in révoque la confiance."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I plugin eseguono script con i tuoi permessi. Considera attendibili solo i plugin che hai scritto o verificato. Se modifichi i file di un plugin, l'attendibilità viene revocata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プラグインはあなたの権限でスクリプトを実行します。自分で作成したか、内容を確認したプラグインだけを信頼してください。プラグインのファイルを変更すると、信頼は取り消されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "플러그인은 사용자의 권한으로 스크립트를 실행합니다. 직접 작성했거나 검토한 플러그인만 신뢰하십시오. 플러그인 파일을 변경하면 신뢰가 취소됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os plug-ins executam scripts com as suas permissões. Confie apenas em plug-ins que você escreveu ou revisou. Alterar os arquivos de um plug-in revoga a confiança."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Плагины выполняют скрипты с вашими правами. Доверяйте только плагинам, которые вы написали или проверили. Изменение файлов плагина отзывает доверие."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eklentiler betikleri sizin izinlerinizle çalıştırır. Yalnızca kendi yazdığınız veya incelediğiniz eklentilere güvenin. Bir eklentinin dosyalarını değiştirmek güveni geri alır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "插件会以你的权限运行脚本。只信任你自己编写或审查过的插件。更改插件的文件会撤销信任。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "外掛程式會以你的權限執行工序指令。請只信任你自己撰寫或審閱過的外掛程式。更改外掛程式的檔案會撤銷信任。"
          }
        }
      }
    },
