    "about.principle.efficient" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ereignisgesteuert: Ungenutzte Funktionen verbrauchen weder CPU noch Batterie"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Event-driven: idle features cost no CPU or battery"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Basado en eventos: las funciones inactivas no consumen CPU ni batería"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Piloté par les événements : les fonctions inactives ne consomment ni processeur ni batterie"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Basato su eventi: le funzioni inattive non consumano CPU né batteria"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "イベント駆動：使っていない機能はCPUやバッテリーを消費しません"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이벤트 기반: 사용하지 않는 기능은 CPU나 배터리를 소모하지 않음"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orientado a eventos: recursos ociosos não gastam CPU nem bateria"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Событийная модель: неактивные функции не расходуют ресурсы процессора и заряд аккумулятора"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Olay odaklı: boşta duran özellikler CPU veya pil tüketmez"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "事件驱动：闲置的功能不占用 CPU 或电池"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "事件驅動：閒置的功能不耗用 CPU 或電池"
          }
        }
      }
    },
