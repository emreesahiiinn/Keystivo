    "workspaces.appGroupsFooter" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mehrere Apps gemeinsam öffnen, fokussieren oder ausblenden. Im Fensterumschalter G drücken, um nach Gruppe zu filtern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open, focus or hide a set of apps together. Press G in the window switcher to filter by group."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre, trae al frente u oculta un conjunto de apps a la vez. Pulsa G en el selector de ventanas para filtrar por grupo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvrez, activez ou masquez un ensemble d'apps en une fois. Appuyez sur G dans le sélecteur de fenêtres pour filtrer par groupe."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apri, attiva o nascondi un insieme di app contemporaneamente. Premi G nel selettore finestre per filtrare per gruppo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "複数のアプリをまとめて開いたり、前面に表示したり、隠したりできます。ウインドウスイッチャーでGを押すと、グループで絞り込めます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "여러 앱을 함께 열거나, 전환하거나, 가립니다. 윈도우 전환기에서 G를 누르면 그룹별로 필터링됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abra, foque ou oculte um conjunto de apps de uma vez. Pressione G no alternador de janelas para filtrar por grupo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Открывайте, активируйте или скрывайте набор приложений одновременно. Нажмите G в переключателе окон, чтобы отфильтровать по группе."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir uygulama kümesini birlikte açın, öne getirin veya gizleyin. Gruba göre süzmek için pencere değiştiricide G tuşuna basın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同时打开、激活或隐藏一组 App。在窗口切换器中按 G 可按组过滤。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同時打開、聚焦或隱藏一組 App。在視窗切換器中按 G 可依群組過濾。"
          }
        }
      }
    },
