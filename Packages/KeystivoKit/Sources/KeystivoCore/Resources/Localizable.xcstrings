    "clipboardSettings.accessAsk" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS fragt, bevor Keystivo die Zwischenablage lesen darf. In Systemeinstellungen › Datenschutz & Sicherheit › Aus anderen Apps einsetzen für Keystivo „Immer erlauben“ wählen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS asks before Keystivo can read the clipboard. Choose “Always Allow” for Keystivo in System Settings › Privacy & Security › Paste from Other Apps."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS pregunta antes de que Keystivo pueda leer el portapapeles. Elige “Permitir siempre” para Keystivo en Ajustes del Sistema › Privacidad y seguridad › Pegar desde otras apps."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS demande votre accord avant que Keystivo puisse lire le presse-papiers. Choisissez « Toujours autoriser » pour Keystivo dans Réglages Système › Confidentialité et sécurité › Coller depuis d'autres apps."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS chiede il permesso prima che Keystivo possa leggere gli appunti. Scegli “Consenti sempre” per Keystivo in Impostazioni di Sistema › Privacy e sicurezza › Incolla da altre app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keystivoがクリップボードを読み取る前に、macOSが確認を求めます。「システム設定」›「プライバシーとセキュリティ」›「ほかのアプリからのペースト」で、Keystivoに対して「常に許可」を選択してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keystivo가 클립보드를 읽기 전에 macOS가 확인을 요청합니다. 시스템 설정 › 개인정보 보호 및 보안 › 다른 앱에서 붙여넣기에서 Keystivo에 대해 ‘항상 허용’을 선택하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O macOS pergunta antes de o Keystivo poder ler a área de transferência. Escolha “Sempre Permitir” para o Keystivo em Ajustes do Sistema › Privacidade e Segurança › Colar de Outros Apps."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS запрашивает подтверждение, прежде чем Keystivo сможет прочитать буфер обмена. Выберите «Всегда разрешать» для Keystivo в разделе «Системные настройки» › «Конфиденциальность и безопасность» › «Вставка из других приложений»."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS, Keystivo panoyu okumadan önce izin ister. Sistem Ayarları › Gizlilik ve Güvenlik › Diğer Uygulamalardan Yapıştır bölümünde Keystivo için “Her Zaman İzin Ver” seçeneğini seçin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS 会在 Keystivo 读取剪贴板前进行询问。请前往“系统设置” › “隐私与安全性” › “从其他 App 粘贴”，为 Keystivo 选择“始终允许”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS 會在 Keystivo 讀取剪貼板前詢問你。請在「系統設定」›「隱私權與安全性」›「從其他 App 貼上」中，將 Keystivo 設為「永遠允許」。"
          }
        }
      }
    },
    "clipboardSettings.accessDenied" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Zugriff auf die Zwischenablage ist in Systemeinstellungen › Datenschutz & Sicherheit › Aus anderen Apps einsetzen verweigert, daher kann kein Verlauf aufgezeichnet werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clipboard access is denied in System Settings › Privacy & Security › Paste from Other Apps, so history cannot be recorded."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El acceso al portapapeles está denegado en Ajustes del Sistema › Privacidad y seguridad › Pegar desde otras apps, por lo que no se puede registrar el historial."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'accès au presse-papiers est refusé dans Réglages Système › Confidentialité et sécurité › Coller depuis d'autres apps : l'historique ne peut donc pas être enregistré."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'accesso agli appunti è negato in Impostazioni di Sistema › Privacy e sicurezza › Incolla da altre app, quindi la cronologia non può essere registrata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「システム設定」›「プライバシーとセキュリティ」›「ほかのアプリからのペースト」でクリップボードへのアクセスが拒否されているため、履歴を記録できません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시스템 설정 › 개인정보 보호 및 보안 › 다른 앱에서 붙여넣기에서 클립보드 접근이 거부되어 기록을 저장할 수 없습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O acesso à área de transferência foi negado em Ajustes do Sistema › Privacidade e Segurança › Colar de Outros Apps, por isso o histórico não pode ser registrado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Доступ к буферу обмена запрещен в разделе «Системные настройки» › «Конфиденциальность и безопасность» › «Вставка из других приложений», поэтому история не может сохраняться."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
