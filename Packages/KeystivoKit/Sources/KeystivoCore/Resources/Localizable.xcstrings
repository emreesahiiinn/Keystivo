    "shortcuts.scopeFooter" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App-spezifische Kurzbefehle sind nur aktiv, während die App im Vordergrund ist, und haben Vorrang vor einem globalen Kurzbefehl mit denselben Tasten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App-specific shortcuts are only active while that app is frontmost and override a global shortcut with the same keys."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las funciones rápidas específicas de una app solo están activas mientras esa app está en primer plano y tienen prioridad sobre una función rápida global con las mismas teclas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les raccourcis propres à une app ne sont actifs que lorsque cette app est au premier plan, et remplacent un raccourci global utilisant les mêmes touches."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le abbreviazioni specifiche per app sono attive solo quando l'app è in primo piano e hanno la precedenza su un'abbreviazione globale con gli stessi tasti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリ固有のショートカットは、そのアプリが最前面にあるときだけ有効になり、同じキーのグローバルショートカットより優先されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱별 단축키는 해당 앱이 맨 앞에 있을 때만 활성화되며, 같은 키를 사용하는 전역 단축키보다 우선합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atalhos específicos de apps só ficam ativos enquanto o app está em primeiro plano e substituem um atalho global com as mesmas teclas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сочетания клавиш для конкретных приложений действуют, только когда это приложение активно, и имеют приоритет над глобальными сочетаниями с теми же клавишами."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uygulamaya özel kısayollar yalnızca o uygulama öndeyken etkindir ve aynı tuşları kullanan genel bir kısayolu geçersiz kılar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App 专属快捷键仅在该 App 位于最前面时有效，并会覆盖按键相同的全局快捷键。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App 專屬快速鍵只會在該 App 位於最前方時作用，並會優先於使用相同按鍵的全域快速鍵。"
          }
        }
      }
    },
    "shortcuts.shortcut" : {
      "extractionState" : "manual",
