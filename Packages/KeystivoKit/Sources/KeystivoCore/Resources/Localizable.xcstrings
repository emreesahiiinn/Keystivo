    "permission.screenRecording.reason" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird nur verwendet, um Live-Fenstervorschauen im Umschalter, in Dock-Vorschauen und in der Launcher-Leiste darzustellen. Es wird nichts aufgezeichnet oder gespeichert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Used only to render live window previews in the switcher, Dock previews and launcher bar. Nothing is recorded or stored."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se usa solo para mostrar vistas previas de ventanas en tiempo real en el selector, en el Dock y en la barra de lanzamiento. No se graba ni se guarda nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisée uniquement pour afficher des aperçus en direct des fenêtres dans le sélecteur, les aperçus du Dock et la barre de lancement. Rien n'est enregistré ni stocké."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usato solo per mostrare anteprime dal vivo delle finestre nel selettore, nelle anteprime del Dock e nella barra del launcher. Niente viene registrato o archiviato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スイッチャー、Dockプレビュー、ランチャーバーでライブのウインドウプレビューを表示するためだけに使用されます。収録や保存は一切行いません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "전환기, Dock 미리보기, 런처 막대에서 실시간 윈도우 미리보기를 표시하는 데에만 사용됩니다. 아무것도 녹화하거나 저장하지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usada apenas para exibir pré-visualizações ao vivo das janelas no alternador, no Dock e na barra do iniciador. Nada é gravado ou armazenado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Используется только для показа живых миниатюр окон в переключателе, в Dock и на панели быстрого запуска. Ничего не записывается и не сохраняется."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yalnızca değiştiricide, Dock önizlemelerinde ve başlatıcı çubuğunda canlı pencere önizlemelerini göstermek için kullanılır. Hiçbir şey kaydedilmez veya saklanmaz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅用于在切换器、Dock 预览和启动栏中呈现实时窗口预览。不会录制或存储任何内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "僅用於在切換器、Dock 預覽和啟動器列中呈現即時視窗預覽。不會錄製或儲存任何內容。"
          }
        }
      }
    },
