    "hotkey.error.needsAccessibility" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Kurzbefehl wird von macOS selbst verarbeitet. Zugriff auf die Bedienungshilfen erlauben, damit Keystivo ihn übernehmen kann."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This shortcut is handled by macOS itself. Grant Accessibility access so Keystivo can take it over."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS gestiona esta función rápida. Concede acceso de Accesibilidad para que Keystivo pueda encargarse de ella."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce raccourci est géré par macOS lui-même. Autorisez l'accès Accessibilité pour que Keystivo puisse le prendre en charge."
