    "menuBarSettings.hidingFooter" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In der Menüleiste erscheinen ein Pfeil und ein dezentes Trennzeichen. Symbole mit gedrückter ⌘-Taste links neben das Trennzeichen ziehen, um sie auszublenden; auf den Pfeil klicken, um sie einzublenden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A chevron and a faint separator appear in the menu bar. ⌘-drag icons to the left of the separator to hide them; click the chevron to reveal them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En la barra de menús aparecen un chevrón y un separador tenue. Arrastra con ⌘ los iconos a la izquierda del separador para ocultarlos; haz clic en el chevrón para mostrarlos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un chevron et un léger séparateur apparaissent dans la barre des menus. Faites glisser les icônes avec ⌘ à gauche du séparateur pour les masquer ; cliquez sur le chevron pour les afficher."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nella barra dei menu compaiono una freccia e un separatore discreto. Trascina le icone tenendo premuto ⌘ a sinistra del separatore per nasconderle; fai clic sulla freccia per mostrarle."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メニューバーにシェブロンと薄い区切り線が表示されます。⌘-ドラッグでアイコンを区切り線の左側に移動すると隠れます。シェブロンをクリックすると表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "메뉴 막대에 꺾쇠 아이콘과 흐린 구분선이 나타납니다. 아이콘을 구분선 왼쪽으로 ⌘-드래그하면 가려지고, 꺾쇠 아이콘을 클릭하면 다시 표시됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma seta e um separador discreto aparecem na barra de menus. Arraste os ícones com ⌘ para a esquerda do separador para ocultá-los; clique na seta para mostrá-los."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В строке меню появятся шеврон и тонкий разделитель. Перетащите значки левее разделителя, удерживая ⌘, чтобы скрыть их; нажмите шеврон, чтобы показать их."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menü çubuğunda bir ok işareti ve soluk bir ayırıcı görünür. Simgeleri gizlemek için ⌘ tuşuyla ayırıcının soluna sürükleyin; göstermek için ok işaretini tıklayın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "菜单栏中会出现一个箭头和一条淡色分隔线。按住 ⌘ 将图标拖移到分隔线左侧即可隐藏；点按箭头即可显示它们。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選單列中會出現一個箭頭和一條淡淡的分隔線。按住 ⌘ 將圖像拖移至分隔線左側即可隱藏；按一下箭頭即可顯示。"
          }
        }
      }
    },
