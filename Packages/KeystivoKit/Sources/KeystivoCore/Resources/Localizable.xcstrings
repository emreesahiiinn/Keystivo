    "dockSettings.previewsFooter" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den Zeiger im Dock auf eine App bewegen, um ihre Fenster zu sehen; auf eine Vorschau klicken, um genau zu diesem Fenster zu wechseln."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hover an app in the Dock to see its windows; click a preview to switch to that exact window."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pasa el puntero sobre una app del Dock para ver sus ventanas; haz clic en una vista previa para ir exactamente a esa ventana."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Survolez une app dans le Dock pour voir ses fenêtres ; cliquez sur un aperçu pour passer exactement à cette fenêtre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passa il puntatore su un'app nel Dock per vederne le finestre; fai clic su un'anteprima per passare esattamente a quella finestra."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dock内のアプリにポインタを置くと、そのウインドウが表示されます。プレビューをクリックすると、そのウインドウに直接切り替わります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dock의 앱 위에 포인터를 올리면 해당 앱의 윈도우가 표시되며, 미리보기를 클릭하면 바로 그 윈도우로 전환됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passe o ponteiro sobre um app no Dock para ver as janelas dele; clique em uma pré-visualização para alternar exatamente para essa janela."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Наведите указатель на приложение в Dock, чтобы увидеть его окна; нажмите миниатюру, чтобы перейти именно к этому окну."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pencerelerini görmek için Dock'taki bir uygulamanın üzerine gelin; tam olarak o pencereye geçmek için bir önizlemeyi tıklayın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将指针悬停在 Dock 中的 App 上即可查看其窗口；点按预览即可切换到该窗口。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將指標停留在 Dock 中的 App 上即可查看其視窗；按一下預覽即可切換到該視窗。"
          }
        }
      }
    },
