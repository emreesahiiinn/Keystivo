    "gesturesSettings.bindingsFooter" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf „Aufnehmen“ klicken und die Geste ausführen. Eine auf bestimmte Apps beschränkte Geste hat in diesen Apps Vorrang vor einer globalen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Click Record and perform the gesture. A gesture limited to specific apps overrides a global one in those apps."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haz clic en Grabar y realiza el gesto. Un gesto limitado a apps concretas tiene prioridad sobre uno global en esas apps."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cliquez sur Enregistrer et effectuez le geste. Dans les apps concernées, un geste limité à certaines apps remplace un geste global."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fai clic su Registra ed esegui il gesto. Un gesto limitato a determinate app ha la precedenza su uno globale in quelle app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「記録」をクリックしてジェスチャを実行してください。特定のアプリに限定したジェスチャは、そのアプリ内ではグローバルなジェスチャより優先されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기록을 클릭하고 제스처를 수행하십시오. 특정 앱으로 제한된 제스처는 해당 앱에서 전역 제스처보다 우선합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
