    "links.footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keystivo in Systemeinstellungen › Schreibtisch & Dock als Standardbrowser festlegen; es leitet jeden Link an den richtigen Browser weiter. Beim Klicken auf einen Link ⌥ halten, um einen Browser auszuwählen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Make Keystivo your default browser in System Settings › Desktop & Dock; it forwards every link to the right browser. Hold ⌥ while clicking a link to choose a browser."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Convierte Keystivo en tu navegador predeterminado en Ajustes del Sistema › Escritorio y Dock; enviará cada enlace al navegador adecuado. Mantén pulsada ⌥ al hacer clic en un enlace para elegir un navegador."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites de Keystivo votre navigateur par défaut dans Réglages Système › Bureau et Dock ; il transmet chaque lien au bon navigateur. Maintenez ⌥ en cliquant sur un lien pour choisir un navigateur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imposta Keystivo come browser predefinito in Impostazioni di Sistema › Scrivania e Dock: inoltrerà ogni link al browser giusto. Tieni premuto ⌥ mentre fai clic su un link per scegliere un browser."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「システム設定」›「デスクトップとDock」でKeystivoをデフォルトのブラウザにすると、すべてのリンクが適切なブラウザに転送されます。⌥を押しながらリンクをクリックすると、ブラウザを選択できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시스템 설정 › 데스크탑 및 Dock에서 Keystivo를 기본 브라우저로 설정하십시오. Keystivo가 모든 링크를 알맞은 브라우저로 전달합니다. 링크를 클릭할 때 ⌥를 누르고 있으면 브라우저를 선택할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Torne o Keystivo seu navegador padrão em Ajustes do Sistema › Mesa e Dock; ele encaminha cada link para o navegador certo. Mantenha ⌥ pressionada ao clicar em um link para escolher um navegador."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сделайте Keystivo браузером по умолчанию в разделе «Системные настройки» › «Рабочий стол и Dock» — он будет передавать каждую ссылку нужному браузеру. Удерживайте ⌥ при нажатии ссылки, чтобы выбрать браузер."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sistem Ayarları › Masaüstü ve Dock bölümünde Keystivo'yu varsayılan tarayıcınız yapın; Keystivo her bağlantıyı doğru tarayıcıya iletir. Tarayıcı seçmek için bir bağlantıyı tıklarken ⌥ tuşunu basılı tutun."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请在“系统设置” › “桌面与程序坞”中将 Keystivo 设为默认浏览器；它会将每个链接转发到合适的浏览器。点按链接时按住 ⌥ 可选择浏览器。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在「系統設定」›「桌面與 Dock」中將 Keystivo 設為預設瀏覽器；它會將每個連結轉送至正確的瀏覽器。按一下連結時按住 ⌥ 即可選擇瀏覽器。"
          }
        }
      }
    },
