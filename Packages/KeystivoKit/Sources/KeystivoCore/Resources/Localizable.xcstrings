    "dragSnap.footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Titelleiste eines Fensters an einen Bildschirmrand oder in eine Ecke ziehen: links/rechts für Hälften, Ecken für Viertel, oben zum Maximieren. Eine Vorschau zeigt, wo das Fenster landet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drag a window's title bar to a screen edge or corner: left/right for halves, corners for quarters, the top to maximize. A preview shows where it will land."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrastra la barra de título de una ventana a un borde o una esquina de la pantalla: izquierda/derecha para mitades, esquinas para cuartos y arriba para maximizar. Una vista previa muestra dónde quedará."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites glisser la barre de titre d'une fenêtre vers un bord ou un coin de l'écran : gauche/droite pour les moitiés, coins pour les quarts, haut pour maximiser. Un aperçu indique où elle sera placée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trascina la barra del titolo di una finestra su un bordo o un angolo dello schermo: sinistra/destra per le metà, gli angoli per i quarti, in alto per massimizzare. Un'anteprima mostra dove verrà posizionata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ウインドウのタイトルバーを画面の端または隅にドラッグします。左右の端で1/2、隅で1/4、上端で最大化します。配置先はプレビューで表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "윈도우의 제목 막대를 화면 가장자리나 모서리로 드래그하십시오. 왼쪽/오른쪽은 절반, 모서리는 4분의 1, 상단은 최대화입니다. 윈도우가 놓일 위치가 미리보기로 표시됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arraste a barra de título de uma janela até uma borda ou canto da tela: esquerda/direita para metades, cantos para quartos, o topo para maximizar. Uma pré-visualização mostra onde ela ficará."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перетащите окно за заголовок к краю или углу экрана: влево или вправо — половина, в угол — четверть, вверх — во весь экран. Предпросмотр показывает, где окажется окно."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir pencerenin başlık çubuğunu ekranın bir kenarına veya köşesine sürükleyin: yarılar için sol/sağ, çeyrekler için köşeler, ekranı doldurmak için üst kenar. Bir önizleme pencerenin nereye yerleşeceğini gösterir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将窗口标题栏拖移到屏幕边缘或角落：左/右边缘吸附到二分之一，角落吸附到四分之一，顶部则最大化。预览会显示窗口的落点。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將視窗的標題列拖移至螢幕邊緣或角落：左／右為二分之一，角落為四分之一，頂部為最大化。預覽會顯示視窗將放置的位置。"
          }
        }
      }
    },
