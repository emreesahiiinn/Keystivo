    "mouseKeyboard.remapsFooter" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Physische Tasten neu belegen, global oder für eine einzelne Tastatur (z. B. ⌥ und ⌘ auf einer PC-Tastatur tauschen). Änderungen werden beim Beenden von Keystivo rückgängig gemacht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remap physical keys, globally or for one keyboard (e.g. swap ⌥ and ⌘ on a PC keyboard). Changes are undone when Keystivo quits."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reasigna teclas físicas, de forma global o para un teclado concreto (p. ej., intercambia ⌥ y ⌘ en un teclado de PC). Los cambios se deshacen al salir de Keystivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remappez des touches physiques, globalement ou pour un seul clavier (p. ex. inverser ⌥ et ⌘ sur un clavier PC). Les modifications sont annulées lorsque Keystivo se ferme."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rimappa i tasti fisici, globalmente o per una sola tastiera (ad es. scambia ⌥ e ⌘ su una tastiera PC). Le modifiche vengono annullate quando Keystivo viene chiuso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "物理キーを、すべてのキーボードまたは特定のキーボードでリマップします（例：PCキーボードで⌥と⌘を入れ替える）。変更はKeystivoを終了すると元に戻ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "물리적 키를 전역으로 또는 특정 키보드에만 다시 할당합니다(예: PC 키보드에서 ⌥와 ⌘ 바꾸기). Keystivo를 종료하면 변경 사항이 원래대로 돌아갑니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remapeie teclas físicas, globalmente ou para um teclado (por ex., trocar ⌥ e ⌘ em um teclado de PC). As alterações são desfeitas quando o Keystivo é encerrado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Переназначайте физические клавиши глобально или для одной клавиатуры (например, поменяйте местами ⌥ и ⌘ на клавиатуре для ПК). Изменения отменяются при завершении Keystivo."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fiziksel tuşları genel olarak veya tek bir klavye için yeniden eşleyin (ör. PC klavyesinde ⌥ ve ⌘ tuşlarının yerini değiştirin). Değişiklikler Keystivo kapandığında geri alınır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "全局或针对单个键盘重映射物理按键（例如在 PC 键盘上交换 ⌥ 和 ⌘）。更改会在 Keystivo 退出时撤销。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重新對應實體按鍵，可全域套用或僅套用於單一鍵盤（例如在 PC 鍵盤上互換 ⌥ 和 ⌘）。變更會在 Keystivo 結束時還原。"
          }
        }
      }
    },
