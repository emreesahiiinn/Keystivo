    "clipboardSettings.privacyFooter" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passwörter und andere von Apps als vertraulich markierte Inhalte (nspasteboard.org) werden nie aufgezeichnet. Der Verlauf wird nur auf diesem Mac gespeichert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passwords and other content marked as confidential by apps (nspasteboard.org) are never recorded. History is stored only on this Mac."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las contraseñas y otros contenidos que las apps marcan como confidenciales (nspasteboard.org) nunca se registran. El historial solo se guarda en este Mac."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les mots de passe et autres contenus marqués comme confidentiels par les apps (nspasteboard.org) ne sont jamais enregistrés. L'historique est stocké uniquement sur ce Mac."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le password e gli altri contenuti contrassegnati come riservati dalle app (nspasteboard.org) non vengono mai registrati. La cronologia è archiviata solo su questo Mac."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "パスワードなど、アプリによって機密扱いとされた内容（nspasteboard.org）は記録されません。履歴はこのMacにのみ保存されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "암호 및 앱에서 기밀로 표시한 기타 콘텐츠(nspasteboard.org)는 절대 기록되지 않습니다. 기록은 이 Mac에만 저장됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Senhas e outros conteúdos marcados como confidenciais pelos apps (nspasteboard.org) nunca são registrados. O histórico fica armazenado apenas neste Mac."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пароли и другое содержимое, помеченное приложениями как конфиденциальное (nspasteboard.org), никогда не сохраняются. История хранится только на этом Mac."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parolalar ve uygulamaların gizli olarak işaretlediği diğer içerikler (nspasteboard.org) asla kaydedilmez. Geçmiş yalnızca bu Mac'te saklanır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "密码及其他被 App 标记为机密的内容（nspasteboard.org）永远不会被记录。历史记录仅存储在这台 Mac 上。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "密碼及其他被 App 標記為機密的內容（nspasteboard.org）絕不會被記錄。歷史記錄只會儲存在這台 Mac 上。"
          }
        }
      }
    },
