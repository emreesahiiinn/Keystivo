        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dica: abra o iniciador e digite o que deseja fazer — todos os comandos do Keystivo podem ser buscados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
