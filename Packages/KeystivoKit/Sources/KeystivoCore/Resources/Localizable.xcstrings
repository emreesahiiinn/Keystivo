    "navigationSettings.subtitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alles auf dem Bildschirm anklicken, durchsuchen und scrollen, ohne die Maus zu berühren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Click, search and scroll anything on screen without touching the mouse."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haz clic, busca y desplázate por cualquier elemento de la pantalla sin tocar el ratón."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cliquez, recherchez et faites défiler n'importe quoi à l'écran sans toucher à la souris."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fai clic, cerca e scorri qualsiasi cosa sullo schermo senza toccare il mouse."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マウスに触れずに、画面上のあらゆるものをクリック、検索、スクロールできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "마우스를 건드리지 않고 화면의 모든 것을 클릭하고, 검색하고, 스크롤하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clique, busque e role qualquer coisa na tela sem tocar no mouse."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нажимайте, ищите и прокручивайте что угодно на экране, не касаясь мыши."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fareye dokunmadan ekrandaki her şeyi tıklayın, arayın ve kaydırın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无需触碰鼠标，即可点按、搜索和滚动屏幕上的任何内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不用碰滑鼠，就能按一下、搜尋和捲動螢幕上的任何項目。"
