    "uninstall.confirmMessage" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die App und ihre Dateien (%@) werden in den Papierkorb gelegt. Sie lassen sich aus dem Papierkorb wiederherstellen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The app and its files (%@) are moved to the Trash. You can restore them from the Trash."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La app y sus archivos (%@) se trasladan a la Papelera. Puedes recuperarlos desde la Papelera."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'app et ses fichiers (%@) sont placés dans la Corbeille. Vous pouvez les restaurer depuis la Corbeille."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'app e i suoi file (%@) vengono spostati nel Cestino. Puoi ripristinarli dal Cestino."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリとその関連ファイル（%@）はゴミ箱に移動されます。ゴミ箱から元に戻すことができます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱과 관련 파일(%@)이 휴지통으로 이동됩니다. 휴지통에서 복원할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O app e seus arquivos (%@) serão movidos para o Lixo. Você pode restaurá-los a partir do Lixo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приложение и его файлы (%@) будут перемещены в Корзину. Их можно восстановить из Корзины."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uygulama ve dosyaları (%@) Çöp Sepetine taşınır. Bunları Çöp Sepetinden geri yükleyebilirsiniz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "该 App 及其文件（%@）将被移到废纸篓。你可以从废纸篓中恢复它们。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
