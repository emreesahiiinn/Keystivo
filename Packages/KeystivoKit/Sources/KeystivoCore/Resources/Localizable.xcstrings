      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keystivo wechselt die Sprache sofort. Einige vom System bereitgestellte Bezeichnungen werden erst nach einem Neustart aktualisiert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keystivo switches language instantly. Some system-provided labels update after a restart."
