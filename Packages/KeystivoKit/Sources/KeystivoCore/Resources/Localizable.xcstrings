    "uninstall.intro" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App auswählen oder hier ablegen. Keystivo findet ihre Support-Dateien, Caches und Einstellungen, damit nichts zurückbleibt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose an app or drop it here. Keystivo finds its support files, caches and preferences so nothing is left behind."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige una app o suéltala aquí. Keystivo encuentra sus archivos de soporte, cachés y preferencias para que no quede nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez une app ou déposez-la ici. Keystivo trouve ses fichiers de support, caches et préférences pour ne rien laisser derrière."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli un'app o trascinala qui. Keystivo ne trova i file di supporto, le cache e le preferenze, così non rimane nulla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリを選択するか、ここにドロップしてください。Keystivoがサポートファイル、キャッシュ、環境設定を見つけるので、何も残りません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱을 선택하거나 여기에 놓으십시오. Keystivo가 지원 파일, 캐시 및 환경설정을 찾아 남김없이 제거합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha um app ou solte-o aqui. O Keystivo encontra os arquivos de suporte, caches e preferências dele para que nada fique para trás."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите приложение или перетащите его сюда. Keystivo найдет его вспомогательные файлы, кэши и настройки, чтобы ничего не осталось."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir uygulama seçin veya buraya bırakın. Keystivo; uygulamanın destek dosyalarını, önbelleklerini ve tercihlerini bulur, böylece geride hiçbir şey kalmaz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选取一个 App 或将其拖放到这里。Keystivo 会找出它的支持文件、缓存和偏好设置，不留任何残余。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選擇一個 App 或將其拖放至此。Keystivo 會找出其支援檔案、快取和偏好設定，不留任何殘餘。"
          }
        }
      }
    },
