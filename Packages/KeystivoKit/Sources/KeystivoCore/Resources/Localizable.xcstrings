    "battery.subtitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Batterie am Netzteil auf einem niedrigeren Ladestand halten, um ihre Alterung zu verlangsamen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep the battery at a lower charge while plugged in to slow down battery aging."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén la batería con menos carga mientras está conectada para ralentizar su envejecimiento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maintenez la batterie à un niveau de charge plus bas lorsque le Mac est branché pour ralentir son vieillissement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantieni la batteria a un livello di carica più basso quando è collegata all'alimentatore per rallentarne l'invecchiamento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "電源接続中はバッテリーの充電量を低めに保ち、バッテリーの劣化を遅らせます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "전원이 연결되어 있을 때 배터리를 낮은 충전량으로 유지하여 배터리 노화를 늦춥니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenha a bateria com uma carga menor enquanto estiver conectada para retardar o envelhecimento da bateria."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удерживайте заряд аккумулятора на более низком уровне при подключении к сети, чтобы замедлить его износ."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prize takılıyken pili daha düşük bir şarj düzeyinde tutarak pilin yaşlanmasını yavaşlatın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "接通电源时让电池保持较低电量，以减缓电池老化。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "接上電源時讓電池維持較低的電量，以減緩電池老化。"
          }
        }
      }
    },
