    "diagnostics.performanceFooter" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deaktivierte Funktionen laufen überhaupt nicht. Event-Tap, Trackpad-Engine und Audioverarbeitung starten erst, wenn sie benötigt werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Features that are switched off don't run at all. The input tap, trackpad engine and audio processing only start when something needs them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las funciones desactivadas no se ejecutan en absoluto. La intercepción de entrada, el motor del trackpad y el procesamiento de audio solo se inician cuando algo los necesita."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les fonctions désactivées ne s'exécutent pas du tout. L'interception des entrées, le moteur du trackpad et le traitement audio ne démarrent que lorsqu'ils sont nécessaires."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le funzioni disattivate non vengono eseguite affatto. L'intercettazione dell'input, il motore del trackpad e l'elaborazione audio si avviano solo quando servono."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オフにした機能はまったく動作しません。入力タップ、トラックパッドエンジン、オーディオ処理は、必要になったときにだけ開始されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "꺼져 있는 기능은 전혀 실행되지 않습니다. 입력 탭, 트랙패드 엔진, 오디오 처리는 필요할 때만 시작됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recursos desativados não são executados. A captura de entrada, o mecanismo do trackpad e o processamento de áudio só são iniciados quando algo precisa deles."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выключенные функции не работают вовсе. Перехват ввода, движок трекпада и обработка звука запускаются, только когда они нужны."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kapatılan özellikler hiç çalışmaz. Giriş yakalayıcısı, izleme dörtgeni motoru ve ses işleme yalnızca bir şey onlara ihtiyaç duyduğunda başlar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已关闭的功能完全不会运行。输入监听、触控板引擎和音频处理仅在需要时才会启动。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已關閉的功能完全不會執行。輸入監聽、觸控式軌跡板引擎和音訊處理只會在需要時啟動。"
          }
        }
      }
    },
