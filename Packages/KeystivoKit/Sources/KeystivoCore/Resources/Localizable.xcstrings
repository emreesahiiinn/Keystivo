    "permission.inputMonitoring.reason" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ermöglicht Keystivo, eigene Trackpad-Gesten auf Systemen zu erkennen, die dies erfordern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lets Keystivo recognize custom trackpad gestures on systems that require it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite que Keystivo reconozca gestos personalizados del trackpad en los sistemas que lo requieren."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permet à Keystivo de reconnaître les gestes personnalisés du trackpad sur les systèmes qui l'exigent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consente a Keystivo di riconoscere i gesti del trackpad personalizzati sui sistemi che lo richiedono."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "必要なシステムで、Keystivoがカスタムのトラックパッドジェスチャを認識できるようにします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "필요한 시스템에서 Keystivo가 사용자 설정 트랙패드 제스처를 인식할 수 있도록 합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite que o Keystivo reconheça gestos personalizados do trackpad em sistemas que exigem isso."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Позволяет Keystivo распознавать пользовательские жесты трекпада в системах, где это требуется."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bunu gerektiren sistemlerde Keystivo'nun özel izleme dörtgeni hareketlerini tanımasını sağlar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在有此要求的系统上，让 Keystivo 能够识别自定触控板手势。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在需要此權限的系統上，讓 Keystivo 能辨識自訂觸控式軌跡板手勢。"
          }
        }
      }
    },
