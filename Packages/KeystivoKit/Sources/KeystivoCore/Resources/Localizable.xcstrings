    "mouseKeyboard.buttonsFooter" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seitentasten sind standardmäßig mit Zurück und Vorwärts belegt, was viele Mac-Apps sonst ignorieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Side buttons are mapped to Back and Forward by default, which many Mac apps otherwise ignore."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los botones laterales se asignan por omisión a Atrás y Adelante, que muchas apps de Mac ignoran de otro modo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Par défaut, les boutons latéraux sont associés à Précédent et Suivant, que de nombreuses apps Mac ignorent autrement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per impostazione predefinita i pulsanti laterali sono assegnati a Indietro e Avanti, che molte app per Mac altrimenti ignorano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サイドボタンはデフォルトで「戻る」と「進む」に割り当てられます。多くのMacアプリでは、これらのボタンは通常無視されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "측면 버튼은 기본적으로 뒤로 및 앞으로에 할당됩니다. 많은 Mac 앱은 원래 이 버튼을 무시합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Por padrão, os botões laterais são mapeados para Voltar e Avançar, que muitos apps do Mac ignoram de outra forma."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Боковым кнопкам по умолчанию назначены «Назад» и «Вперед», которые многие приложения для Mac иначе игнорируют."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yan düğmeler varsayılan olarak Geri ve İleri'ye atanır; birçok Mac uygulaması aksi hâlde bunları yok sayar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "侧键默认映射为“后退”和“前进”，否则许多 Mac App 会忽略它们。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "側邊按鈕預設對應至「上一頁」和「下一頁」，許多 Mac App 原本會忽略這些按鈕。"
          }
        }
      }
    },
