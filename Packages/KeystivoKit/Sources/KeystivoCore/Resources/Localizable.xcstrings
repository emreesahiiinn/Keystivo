    "audioSettings.profilesFooter" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Profil speichert Ausgabe- und Eingabegerät, Lautstärke und den Mix pro App. Anwendbar über den Launcher, einen Kurzbefehl oder einen Workflow."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A profile remembers the output and input device, volume and the per-app mix. Apply it from the launcher, a shortcut or a workflow."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un perfil recuerda el dispositivo de salida y de entrada, el volumen y la mezcla por app. Aplícalo desde el lanzador, una función rápida o un flujo de trabajo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un profil mémorise les appareils de sortie et d'entrée, le volume et le mixage par app. Appliquez-le depuis le lanceur, un raccourci ou un workflow."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un profilo ricorda il dispositivo di uscita e di ingresso, il volume e il mix per app. Applicalo dal launcher, con un'abbreviazione o da un flusso di lavoro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プロファイルは、出力/入力デバイス、音量、アプリ別のミックスを記憶します。ランチャー、ショートカット、ワークフローから適用できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "프로필은 출력 및 입력 기기, 음량, 앱별 믹스를 기억합니다. 런처, 단축키 또는 워크플로에서 적용하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um perfil lembra os dispositivos de saída e entrada, o volume e a mixagem por app. Aplique-o pelo iniciador, por um atalho ou por um fluxo de trabalho."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Профиль запоминает устройства вывода и ввода, громкость и громкость каждого приложения. Применяйте его из лаунчера, сочетанием клавиш или в сценарии."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir profil çıkış ve giriş aygıtını, ses düzeyini ve uygulama başına karışımı hatırlar. Profili başlatıcıdan, bir kısayolla veya bir iş akışıyla uygulayın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "方案会记住输出和输入设备、音量以及各 App 的混音设置。可通过启动器、快捷键或工作流程来应用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設定檔會記住輸出與輸入裝置、音量及個別 App 混音。可從啟動器、快速鍵或工作流程套用。"
          }
        }
      }
    },
