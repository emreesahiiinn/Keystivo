    "windowsSettings.subtitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fenster an Hälften, Dritteln und Vierteln ausrichten, zwischen Displays bewegen und Arbeitsplatz-Layouts sichern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Snap windows to halves, thirds and quarters, move them across displays and save desk layouts."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajusta ventanas a mitades, tercios y cuartos, muévelas entre pantallas y guarda disposiciones de tu puesto de trabajo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ancrez les fenêtres en moitiés, tiers et quarts, déplacez-les d'un écran à l'autre et enregistrez des dispositions de bureau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggancia le finestre a metà, terzi e quarti, spostale tra i monitor e salva le disposizioni della postazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ウインドウを1/2、1/3、1/4にスナップし、ディスプレイ間で移動し、デスクのレイアウトを保存します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "윈도우를 절반, 3분의 1, 4분의 1 크기로 스냅하고, 디스플레이 간에 이동하며, 작업 레이아웃을 저장합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encaixe janelas em metades, terços e quartos, mova-as entre telas e salve layouts de trabalho."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Привязывайте окна к половинам, третям и четвертям экрана, перемещайте их между дисплеями и сохраняйте макеты рабочего места."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pencereleri yarılara, üçte birlere ve çeyreklere yaslayın, ekranlar arasında taşıyın ve masa yerleşimlerini kaydedin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将窗口吸附到二分之一、三分之一和四分之一区域，在显示器之间移动窗口，并存储桌面布局。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將視窗貼齊至二分之一、三分之一和四分之一，在顯示器之間移動，並儲存桌面佈局。"
          }
        }
      }
    },
