    "permissions.staleEntryHint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bereits in den Systemeinstellungen aktiviert, aber immer noch nicht erteilt? Dieser Entwicklungs-Build wurde neu signiert: Keystivo mit − aus der Liste entfernen und dann erneut auf „Zugriff erlauben“ klicken."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Already switched on in System Settings but still not granted? This development build was re-signed: remove Keystivo from the list with −, then press Grant Access again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Ya está activado en Ajustes del Sistema, pero sigue sin concederse? Esta versión de desarrollo se ha vuelto a firmar: elimina Keystivo de la lista con − y vuelve a pulsar Permitir acceso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déjà activé dans Réglages Système mais toujours pas accordé ? Cette version de développement a été signée à nouveau : supprimez Keystivo de la liste avec −, puis cliquez à nouveau sur Autoriser l'accès."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Già attivato in Impostazioni di Sistema ma il permesso non risulta ancora concesso? Questa build di sviluppo è stata firmata di nuovo: rimuovi Keystivo dall'elenco con −, quindi premi di nuovo Consenti accesso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "システム設定ですでにオンにしているのに、まだ許可されていませんか？この開発ビルドは再署名されています。−を使ってリストからKeystivoを削除してから、もう一度「アクセスを許可」を押してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시스템 설정에서 이미 켰는데도 여전히 허용되지 않습니까? 이 개발 빌드는 다시 서명되었습니다. −를 눌러 목록에서 Keystivo를 제거한 다음 ‘접근 허용’을 다시 누르십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Já está ativado nos Ajustes do Sistema, mas a permissão ainda não foi concedida? Esta versão de desenvolvimento foi assinada novamente: remova o Keystivo da lista com −, depois clique em Permitir Acesso de novo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Доступ уже включен в Системных настройках, но разрешение все равно не предоставлено? Эта сборка для разработки была переподписана: удалите Keystivo из списка кнопкой −, затем снова нажмите «Разрешить доступ»."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sistem Ayarları'nda zaten açık olduğu hâlde izin hâlâ verilmemiş mi? Bu geliştirme sürümü yeniden imzalandı: Keystivo'yu − ile listeden kaldırın, ardından Erişim Ver düğmesine yeniden basın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已在“系统设置”中打开，但仍未获得授权？此开发版本已重新签名：请用 − 将 Keystivo 从列表中移除，然后再次点按“授予访问权限”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已在「系統設定」中開啟，但仍顯示未授予？此開發版本已重新簽署：請使用 − 從列表中移除 Keystivo，然後再按一次「授予取用權限」。"
          }
        }
      }
    },
