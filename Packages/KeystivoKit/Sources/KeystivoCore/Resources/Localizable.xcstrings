    "windowsSettings.layoutsFooter" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Layouts merken sich die Position jedes Fensters pro Display. Automatische Wiederherstellung aktivieren, um den Arbeitsplatz wiederherzustellen, sobald dieselben Monitore angeschlossen werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Layouts remember where every window is, per display. Turn on automatic restore to rebuild your desk when you plug in the same monitors."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las disposiciones recuerdan dónde está cada ventana, por pantalla. Activa la restauración automática para recomponer tu puesto de trabajo al conectar los mismos monitores."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les dispositions mémorisent l'emplacement de chaque fenêtre, écran par écran. Activez la restauration automatique pour reconstituer votre poste de travail lorsque vous rebranchez les mêmes moniteurs."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le disposizioni ricordano dove si trova ogni finestra, per ciascun monitor. Attiva il ripristino automatico per ricostruire la tua postazione quando colleghi gli stessi monitor."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "レイアウトは、ディスプレイごとにすべてのウインドウの位置を記憶します。自動復元をオンにすると、同じモニタを接続したときにデスクの配置を再現できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "레이아웃은 디스플레이별로 모든 윈도우의 위치를 기억합니다. 자동 복원을 켜면 같은 모니터를 연결할 때 작업 환경이 다시 구성됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os layouts lembram onde cada janela está, por tela. Ative a restauração automática para reconstruir seu ambiente de trabalho ao conectar os mesmos monitores."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Макеты запоминают положение каждого окна на каждом дисплее. Включите автоматическое восстановление, чтобы рабочее место восстанавливалось при подключении тех же мониторов."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yerleşimler, her pencerenin ekran bazında nerede olduğunu hatırlar. Aynı monitörleri taktığınızda masanızı yeniden kurmak için otomatik geri yüklemeyi açın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "布局会按显示器记住每个窗口的位置。打开自动恢复后，接入同样的显示器时即可重建你的桌面布局。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "佈局會依顯示器記住每個視窗的位置。開啟自動回復，即可在接上相同的顯示器時重建你的桌面配置。"
          }
        }
      }
    },
