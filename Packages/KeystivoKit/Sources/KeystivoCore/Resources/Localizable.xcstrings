    "shortcuts.subtitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kurzbefehle, die eine Aktion oder eine Kette von Aktionen ausführen – global oder nur in bestimmten Apps."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Global shortcuts that run one action or a chain of actions, globally or only in specific apps."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Funciones rápidas que ejecutan una acción o una cadena de acciones, en todo el sistema o solo en apps concretas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Des raccourcis globaux qui exécutent une action ou une chaîne d'actions, partout ou uniquement dans certaines apps."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abbreviazioni globali che eseguono un'azione o una catena di azioni, ovunque o solo in app specifiche."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ひとつのアクションまたは一連のアクションを実行するショートカット。すべての場所で、または特定のアプリだけで使えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "하나의 동작 또는 일련의 동작을 실행하는 단축키로, 전역 또는 특정 앱에서만 작동합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atalhos globais que executam uma ação ou uma sequência de ações, em todo o sistema ou apenas em apps específicos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Глобальные сочетания клавиш, которые запускают одно действие или цепочку действий — везде или только в определенных приложениях."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tek bir eylemi veya bir eylem zincirini her yerde ya da yalnızca belirli uygulamalarda çalıştıran genel kısayollar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "运行单个操作或一系列操作的快捷键，可全局生效，也可仅在特定 App 中生效。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "執行單一動作或一連串動作的快速鍵，可全域使用或僅限於特定 App。"
          }
        }
      }
    },
