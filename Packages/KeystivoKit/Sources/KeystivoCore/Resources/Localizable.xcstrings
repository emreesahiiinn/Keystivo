    "library.battery.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim Trennen vom Netzteil und einem Batteriestand unter 50 % zum Profil „Batteriesparen“ wechseln."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When you unplug, switch to the Battery Saver profile if the battery is below 50%."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al desconectar la corriente, cambia al perfil Ahorro de batería si la batería está por debajo del 50 %."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Au débranchement de l'adaptateur secteur, passe au profil Économie de batterie si la batterie est inférieure à 50 %."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando scolleghi l'alimentatore, passa al profilo Risparmio batteria se la batteria è sotto il 50%."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "電源を外したときにバッテリー残量が50%未満なら、バッテリー節約プロファイルに切り替えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "전원을 분리했을 때 배터리가 50% 미만이면 배터리 절약 프로필로 전환합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ao desconectar da energia, alternar para o perfil Economia de Bateria se a bateria estiver abaixo de 50%."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "При отключении от сети переключаться на профиль «Экономия заряда», если заряд аккумулятора ниже 50 %."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fişi çektiğinizde pil %50'nin altındaysa Pil Tasarrufu profiline geçer."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拔下电源时，如果电池电量低于 50%，则切换到“省电”方案。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拔除電源時，若電池電量低於 50%，就切換至「省電」設定檔。"
          }
        }
      }
    },
