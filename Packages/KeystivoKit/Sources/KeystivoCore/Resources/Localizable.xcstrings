    "library.dock.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn ein externes Display angeschlossen wird, Fenster darauf sammeln und die Audioausgabe wechseln."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When an external display connects, gather windows onto it and switch audio output."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando se conecta una pantalla externa, reúne las ventanas en ella y cambia la salida de audio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lorsqu'un écran externe est connecté, y rassemble les fenêtres et change la sortie audio."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando si collega un monitor esterno, vi raccoglie le finestre e cambia l'uscita audio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "外部ディスプレイが接続されたら、ウインドウをそこに集めてオーディオ出力を切り替えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "외부 디스플레이가 연결되면 윈도우를 해당 디스플레이로 모으고 오디오 출력을 전환합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando uma tela externa for conectada, reunir as janelas nela e alternar a saída de áudio."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "При подключении внешнего дисплея собирать на нем окна и переключать аудиовыход."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Harici bir ekran bağlandığında pencereleri o ekrana toplar ve ses çıkışını değiştirir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
