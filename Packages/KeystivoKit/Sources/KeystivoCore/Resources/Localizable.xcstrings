    "permission.automation.reason" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird für Systembefehle wie das Umschalten des Dunkelmodus, Neustarten oder Abmelden verwendet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Used by system commands such as toggling Dark Mode, restarting or logging out."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo usan comandos del sistema como activar el modo oscuro, reiniciar o cerrar sesión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisée par des commandes système comme l'activation du mode sombre, le redémarrage ou la fermeture de session."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usato dai comandi di sistema, ad esempio per attivare/disattivare la Modalità scura, riavviare o terminare la sessione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ダークモードの切り替え、再起動、ログアウトなどのシステムコマンドで使用されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다크 모드 전환, 재시동, 로그아웃과 같은 시스템 명령에 사용됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
