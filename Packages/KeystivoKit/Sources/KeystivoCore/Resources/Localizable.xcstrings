    "library.meeting.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn Zoom oder Teams geöffnet wird, Musik-Apps stummschalten und sicherstellen, dass das Mikrofon an ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When Zoom or Teams opens, mute music apps and make sure your microphone is on."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando se abre Zoom o Teams, silencia las apps de música y se asegura de que el micrófono esté activado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lorsque Zoom ou Teams s'ouvre, coupe le son des apps de musique et s'assure que votre micro est activé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando si apre Zoom o Teams, disattiva l'audio delle app musicali e si assicura che il microfono sia attivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ZoomまたはTeamsが開いたら、音楽アプリを消音し、マイクがオンになっていることを確認します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zoom 또는 Teams가 열리면 음악 앱을 음소거하고 마이크가 켜져 있는지 확인합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando o Zoom ou o Teams abrir, silenciar os apps de música e garantir que o microfone esteja ativado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "При открытии Zoom или Teams выключать звук музыкальных приложений и проверять, что микрофон включен."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zoom veya Teams açıldığında müzik uygulamalarının sesini kapatır ve mikrofonunuzun açık olduğundan emin olur."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "打开 Zoom 或 Teams 时，将音乐 App 静音并确保麦克风已打开。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zoom 或 Teams 打開時，將音樂 App 靜音並確保麥克風已開啟。"
          }
        }
      }
    },
