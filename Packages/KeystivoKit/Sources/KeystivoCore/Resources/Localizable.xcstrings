    "launcherSettings.tips" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tipps: ⌘K zeigt Aktionen für das ausgewählte Ergebnis, ⌘1–⌘9 führen ein Ergebnis direkt aus, ⇥ vervollständigt, ⌫ in einem leeren Feld geht zurück."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tips: ⌘K shows actions for the selected result, ⌘1–⌘9 run a result directly, ⇥ autocompletes, ⌫ on an empty field goes back."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consejos: ⌘K muestra las acciones del resultado seleccionado, ⌘1–⌘9 ejecutan un resultado directamente, ⇥ autocompleta y ⌫ en un campo vacío vuelve atrás."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Astuces : ⌘K affiche les actions du résultat sélectionné, ⌘1–⌘9 exécutent directement un résultat, ⇥ complète automatiquement, ⌫ dans un champ vide permet de revenir en arrière."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suggerimenti: ⌘K mostra le azioni per il risultato selezionato, ⌘1–⌘9 eseguono direttamente un risultato, ⇥ completa automaticamente, ⌫ su un campo vuoto torna indietro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ヒント：⌘Kで選択した結果のアクションを表示、⌘1〜⌘9で結果を直接実行、⇥で自動補完、空の検索欄で⌫を押すと戻ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "팁: ⌘K는 선택한 결과의 동작을 표시하고, ⌘1–⌘9는 결과를 바로 실행하며, ⇥는 자동 완성하고, 빈 필드에서 ⌫는 뒤로 돌아갑니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dicas: ⌘K mostra ações para o resultado selecionado, ⌘1–⌘9 executam um resultado diretamente, ⇥ completa automaticamente e ⌫ em um campo vazio volta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Советы: ⌘K показывает действия для выбранного результата, ⌘1–⌘9 сразу запускают результат, ⇥ дополняет ввод, ⌫ в пустом поле возвращает назад."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İpuçları: ⌘K seçili sonucun eylemlerini gösterir, ⌘1–⌘9 bir sonucu doğrudan çalıştırır, ⇥ otomatik tamamlar, boş alanda ⌫ geri gider."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "提示：⌘K 显示所选结果的操作，⌘1–⌘9 直接运行对应结果，⇥ 自动补全，在空白输入框中按 ⌫ 返回。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
