    "onboarding.permissionsBody" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS schützt diese Funktionen. Nur gewähren, was wirklich gebraucht wird – jede Funktion erklärt, warum sie fragt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS protects these capabilities. Grant only what you need — every feature explains why it asks."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS protege estas funciones. Concede solo lo que necesites: cada función explica por qué lo pide."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS protège ces fonctionnalités. N'accordez que ce dont vous avez besoin — chaque fonction explique pourquoi elle le demande."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS protegge queste funzionalità. Concedi solo ciò che ti serve: ogni funzione spiega perché lo chiede."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これらの機能はmacOSによって保護されています。必要なものだけを許可してください。各機能がアクセスを求める理由を説明します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS는 이러한 기능을 보호합니다. 필요한 권한만 허용하십시오. 각 기능이 권한을 요청하는 이유를 설명합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O macOS protege esses recursos. Conceda apenas o que você precisa — cada recurso explica por que pede acesso."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS защищает эти возможности. Предоставляйте только то, что нужно, — каждая функция объясняет, зачем ей доступ."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS bu yetenekleri korur. Yalnızca ihtiyacınız olanlara izin verin — her özellik neden izin istediğini açıklar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS 会保护这些功能。只需授予你需要的权限——每项功能都会说明请求的原因。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS 會保護這些功能。只授予你需要的權限——每項功能都會說明需要權限的原因。"
          }
        }
      }
    },
    "onboarding.permissionsFooter" : {
      "extractionState" : "manual",
      "localizations" : {
