        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keystivo cambia de idioma al instante. Algunas etiquetas proporcionadas por el sistema se actualizan tras reiniciar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keystivo change de langue instantanément. Certains libellés fournis par le système sont mis à jour après un redémarrage."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keystivo cambia lingua all'istante. Alcune etichette fornite dal sistema si aggiornano dopo un riavvio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keystivoの言語はすぐに切り替わります。システムが提供する一部のラベルは再起動後に更新されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keystivo는 언어를 즉시 전환합니다. 일부 시스템 제공 레이블은 다시 시작한 후에 업데이트됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Keystivo muda de idioma instantaneamente. Alguns rótulos fornecidos pelo sistema são atualizados após reiniciar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keystivo меняет язык мгновенно. Некоторые системные надписи обновятся после перезапуска."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
