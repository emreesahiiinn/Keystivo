          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Переносите настройки между компьютерами Mac, делитесь их частями или возвращайтесь к более ранней версии."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
