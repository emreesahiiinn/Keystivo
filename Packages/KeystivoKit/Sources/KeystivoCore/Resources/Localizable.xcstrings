      }
    },
    "onboarding.shortcutsFooter" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tipp: Launcher öffnen und eintippen, was erledigt werden soll – jeder Keystivo-Befehl ist durchsuchbar."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
