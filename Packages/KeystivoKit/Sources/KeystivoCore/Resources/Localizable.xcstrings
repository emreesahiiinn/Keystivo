    "presentation.footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nützlich für Demos, Aufnahmen und Bildschirmfreigabe. Passwortfelder werden nie angezeigt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Useful for demos, recordings and screen sharing. Password fields are never shown."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Útil para demostraciones, grabaciones y para compartir pantalla. Los campos de contraseña nunca se muestran."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utile pour les démonstrations, les enregistrements et le partage d'écran. Les champs de mot de passe ne sont jamais affichés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utile per demo, registrazioni e condivisione dello schermo. I campi password non vengono mai mostrati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デモ、収録、画面共有に便利です。パスワードフィールドの入力は表示されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "데모, 녹화 및 화면 공유에 유용합니다. 암호 필드는 절대 표시되지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Útil para demonstrações, gravações e compartilhamento de tela. Campos de senha nunca são mostrados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удобно для демонстраций, записей и показа экрана. Ввод в полях паролей никогда не отображается."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tanıtımlar, kayıtlar ve ekran paylaşımı için kullanışlıdır. Parola alanları asla gösterilmez."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "适用于演示、录制和屏幕共享。绝不显示密码栏中的输入。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "適合用於示範、錄影和螢幕共享。密碼欄位絕不會顯示。"
          }
        }
      }
    },
