    "library.headphones.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lautstärke auf ein sicheres Niveau senken, sobald sich die Audioausgabe ändert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lower the volume to a safe level whenever the audio output changes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baja el volumen a un nivel seguro cada vez que cambia la salida de audio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baisse le volume à un niveau sûr chaque fois que la sortie audio change."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abbassa il volume a un livello sicuro ogni volta che cambia l'uscita audio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オーディオ出力が変わるたびに、音量を安全なレベルまで下げます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오디오 출력이 변경될 때마다 음량을 안전한 수준으로 낮춥니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diminuir o volume para um nível seguro sempre que a saída de áudio mudar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Снижать громкость до безопасного уровня при каждой смене аудиовыхода."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ses çıkışı her değiştiğinde ses düzeyini güvenli bir seviyeye düşürür."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每当音频输出发生变化时，将音量降低到安全水平。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每當音訊輸出變更時，將音量降至安全程度。"
          }
        }
      }
    },
