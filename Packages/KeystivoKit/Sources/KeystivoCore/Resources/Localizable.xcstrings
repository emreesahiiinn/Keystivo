    "screenTools.subtitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bildschirm aufnehmen, beschriften und als Video aufzeichnen, Text und QR-Codes von überall erfassen, Farben aufnehmen und Bildschirmfotos anheften."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Capture, annotate and record the screen, grab text and QR codes, pick colors and pin screenshots."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Captura, anota y graba la pantalla, extrae texto y códigos QR de cualquier lugar, selecciona colores y fija capturas de pantalla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Capturez, annotez et enregistrez l'écran, récupérez du texte et des codes QR n'importe où, prélevez des couleurs et épinglez des captures d'écran."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cattura, annota e registra lo schermo, cattura testo e codici QR ovunque, preleva colori e fissa istantanee."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "画面をキャプチャ、注釈付け、収録し、どこからでもテキストやQRコードを取り込み、カラーを取得し、スクリーンショットをピン留めします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "화면을 캡처하고 주석을 달고 기록하며, 어디서나 텍스트와 QR 코드를 가져오고, 색상을 선택하고, 스크린샷을 고정합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Capture, anote e grave a tela, extraia textos e códigos QR de qualquer lugar, selecione cores e fixe capturas de tela."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Делайте снимки экрана, аннотируйте и записывайте экран, захватывайте текст и QR-коды откуда угодно, выбирайте цвета и закрепляйте снимки."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ekranı yakalayın, işaretleyin ve kaydedin; her yerden metin ve QR kodu alın, renk seçin ve ekran resimlerini sabitleyin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "截取、标注和录制屏幕，从任意位置提取文本和二维码、拾取颜色并固定截屏。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "擷取、標註和錄製螢幕，從任何地方擷取文字和 QR 碼、挑選顏色，以及釘選截圖。"
          }
        }
      }
    },
