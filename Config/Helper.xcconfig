// Privileged helper tool (battery charge limiting). Embedded in Keystivo.app/Contents/MacOS.
PRODUCT_NAME = KeystivoHelper
PRODUCT_BUNDLE_IDENTIFIER = com.keystivo.Keystivo.helper
MACOSX_DEPLOYMENT_TARGET = 15.0
SDKROOT = macosx
SWIFT_VERSION = 6.0
SKIP_INSTALL = YES
ENABLE_HARDENED_RUNTIME = YES
GENERATE_INFOPLIST_FILE = YES
CREATE_INFOPLIST_SECTION_IN_BINARY = YES
MARKETING_VERSION = 1.0
CURRENT_PROJECT_VERSION = 1
CODE_SIGN_STYLE = Automatic
CODE_SIGN_IDENTITY = -
DEVELOPMENT_TEAM =
KEYSTIVO_ADHOC_REQUIREMENT = --requirements "=designated => identifier \"$(PRODUCT_BUNDLE_IDENTIFIER)\""
OTHER_CODE_SIGN_FLAGS = $(inherited) $(KEYSTIVO_ADHOC_REQUIREMENT)

#include? "Local.xcconfig"
